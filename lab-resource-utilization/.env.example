# ==================================================
# BREVO EMAIL SERVICE CONFIGURATION
# ==================================================
# 1. Go to https://app.brevo.com/account/register (FREE)
# 2. Verify your account
# 3. Go to Settings → SMTP & API → SMTP
# 4. Copy the login and password values below

BREVO_SMTP_LOGIN=your-email@example.com
BREVO_SMTP_PASSWORD=your-brevo-smtp-key

# ==================================================
# DATABASE CONFIGURATION
# ==================================================
DB_URL=jdbc:postgresql://localhost:5432/mydb
DB_USERNAME=postgres
DB_PASSWORD=your-database-password

# ==================================================
# APPLICATION CONFIGURATION
# ==================================================
APP_NAME=Lab Resource Platform
APP_BASE_URL=http://localhost:5173
APP_SUPPORT_EMAIL=support@labresource.com